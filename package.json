		"motion": "^12.40.0",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.4.3",
		"react": "^19.2.7",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.7",
		"react-number-format": "^5.4.5",
		"react-phone-number-input": "^3.4.17",
		"react-router": "^8",
		"recharts": "^3.8.1",
