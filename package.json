{
	"name": "ventura-starter",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun react-router dev",
		"dev:cloudflare": "bun react-router dev --mode cloudflare",
		"build": "react-router build",
		"build:cloudflare": "react-router build --mode cloudflare",
		"start": "bun run build && vite preview",
		"typecheck": "wrangler types && react-router typegen && tsc",
		"cf-typegen": "wrangler types",
		"preview": "bun run build && vite preview",
		"deploy": "bun run build:cloudflare && wrangler deploy",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"setup": "bun run scripts/setup.ts",
		"prepare": "lefthook install",
		"icon": "bunx @sly-cli/sly add lucide-icons",
		"db:up": "docker compose up -d postgres",
		"db:down": "docker compose stop postgres",
		"db:logs": "docker compose logs -f postgres",
		"db:check": "drizzle-kit check --config=app/drizzle/drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config=app/drizzle/drizzle.config.ts",
		"db:push:local": "drizzle-kit push --config=app/drizzle/drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config=app/drizzle/drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config=app/drizzle/drizzle.config.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@cloudflare/vite-plugin": "^1.40.0",
		"@playwright/test": "^1.60.0",
		"@react-router/dev": "^8",
		"@react-router/fs-routes": "^8",
		"@sly-cli/sly": "^2.1.1",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "latest",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"autoprefixer": "^10.5.0",
		"jsdom": "^26.1.0",
		"lefthook": "^1.13.6",
		"shadcn": "^3.8.5",
		"tailwindcss": "^4.3.0",
		"tailwindcss-animate": "^1.0.7",
		"tsconfig-paths-webpack-plugin": "^4.2.0",
		"vite": "^7.3.5",
		"vite-plugin-icons-spritesheet": "^3.1.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^3.2.6",
		"wrangler": "^4.98.0"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@conform-to/react": "^1.19.3",
		"@conform-to/zod": "^1.19.3",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@epic-web/cachified": "^5.6.2",
		"@epic-web/client-hints": "^1.3.9",
		"@epic-web/invariant": "^1.0.0",
		"@epic-web/remember": "^1.1.0",
		"@epic-web/totp": "^4.0.1",
		"@forge42/seo-tools": "^1.4.5",
		"@nasa-gcn/remix-seo": "^2.0.1",
		"@number-flow/react": "^0.6.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@paralleldrive/cuid2": "^3.3.0",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-icons": "^1.3.2",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@react-email/components": "^1.0.12",
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.2",
		"@tanstack/match-sorter-utils": "^8.19.4",
		"@tanstack/react-table": "^8.21.3",
		"@tusbar/cache-control": "^3.0.1",
		"@types/qrcode": "^1.5.6",
		"bcryptjs": "^3.0.3",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
